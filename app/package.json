{
  "name": "offline-nav",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "pack": "node scripts/pack/build-pack.mjs --radius 4000 --name \"Stratford and the Olympic Park\"",
    "check:nav": "npx -y tsx@4.20.6 scripts/check/nav-check.ts",
    "map:offline": "node scripts/map/fetch-offline-map.mjs",
    "sidecar": "sh -c 'P=sidecar/.venv/bin/python; [ -x \"$P\" ] || P=python3; exec \"$P\" sidecar/server.py'",
    "sidecar:mock": "SIDECAR_MOCK=1 python3 sidecar/server.py",
    "check:safety": "npx -y tsx@4.20.6 scripts/check/safety-check.ts",
    "sidecar:setup": "python3 -m venv sidecar/.venv && sidecar/.venv/bin/pip install -r sidecar/requirements.txt"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "maplibre-gl": "^6.16.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
